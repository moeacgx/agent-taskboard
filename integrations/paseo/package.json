{
  "name": "dashi-taskboard-paseo-plugin",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "scripts/",
    "runtime/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=60000 test/dashi-api.test.ts test/board.test.ts test/dispatch.test.ts test/board-api.test.ts test/lifecycle.test.ts test/turn-ownership.test.ts test/plugin-update.test.ts test/task-message-images.test.ts",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "build:original-srcdoc": "npx vite build --config ../../web/vite.paseo.config.ts && node ../../scripts/build-paseo-srcdoc.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@getpaseo/client": "0.8.0",
    "@getpaseo/plugin": "0.8.0",
    "@getpaseo/protocol": "0.8.0",
    "@types/react": "~19.1.17",
    "react": "~19.1.0",
    "react-native": "0.81.5",
    "typescript": "^7.0.2"
  }
}
